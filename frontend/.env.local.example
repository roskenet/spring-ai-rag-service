# Backend API URL Configuration
#
# This environment variable configures the backend base URL used by all proxy API routes.
# The proxy automatically appends /api to this URL, so do NOT include /api suffix here.
#
# NOTE: This is a server-side only variable, NOT exposed to the browser
# NOTE: Never include /api suffix - it's added per endpoint
#
# IMPORTANT FOR DOCKER:
# When running in Docker (via run-local.sh), the frontend container must use the
# backend service hostname (from docker-compose.yml) for inter-container communication:
#   - Docker: http://backend:8080 (service name, NOT localhost)
#   - Local Dev: http://localhost:8080
# The run-local.sh script automatically sets this correctly.
#
# Environment Examples:
# - Local Development (npm run dev): http://localhost:8080
# - Docker (run-local.sh): http://backend:8080
# - Staging K8s: https://zeos-rag-backend-staging.zfs-test.zalan.do
# - Production K8s: https://zeos-rag-backend.zalan.do

BACKEND_API_URL=http://localhost:8080

# For Docker deployment:
# BACKEND_API_URL=http://backend:8080

# For Staging K8s deployment:
# BACKEND_API_URL=https://zeos-rag-backend-staging.zfs-test.zalan.do

# For Production K8s deployment:
# BACKEND_API_URL=https://zeos-rag-backend.zalan.do